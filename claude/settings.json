{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": false,
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(cafleet message *)",
      "Bash(cafleet monitor *)",
      "Bash(cafleet member ping *)",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Write",
      "Read(/settings.json)",
      "Read(/skills/**)",
      "Read(/plugins/**)",
      "Read(~/.agent-browser/tmp)",
      "Skill(agent-browser)",
      "Skill(github-cli)",
      "Skill(loop)",
      "Skill(pathfinder-explain)",
      "Skill(review-claude-config)",
      "Skill(update-config)",
      "Skill(cafleet)",
      "Skill(cafleet-design-doc)",
      "mcp__pathfinder-python__definition"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(uv sync)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/english_review.py"
          }
        ]
      }
    ]
  },
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/bin/status.py"
  },
  "enabledPlugins": {
    "agent-browser@himkt-marketplace": true,
    "slidev@himkt-marketplace": true
  },
  "extraKnownMarketplaces": {
    "himkt-marketplace": {
      "source": {
        "source": "github",
        "repo": "himkt/himkt-marketplace"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "language": "Use professional English",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "autoInstallIdeExtension": false
}
