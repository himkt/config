# Residual packages mise bootstrap cannot install (see README § Packages).
# himkt/tap publishes no Homebrew API metadata (api/formula/NAME.json,
# api/cask/NAME.json), which mise's brew managers require; mise does not
# proxy to the brew CLI. Installed via Homebrew:
#   make brew-residual
tap  'himkt/tap'
brew 'himkt/tap/cafleet'
brew 'himkt/tap/pathfinder'
brew 'himkt/tap/tips-cli'
cask 'himkt/tap/voicevox'
